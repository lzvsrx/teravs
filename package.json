{
  "name": "teravs",
  "version": "0.3.1",
  "description": "Teravs — assistente inclusivo com estúdio criativo e memória controlável",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k \"node --env-file-if-exists=.env server/index.mjs\" \"vite\"",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "test:server": "node --test tests-server/*.test.mjs",
    "build": "tsc && vite build",
    "start": "npm run build && node scripts/start.cjs",
    "package:windows": "npm run build && electron-builder --win portable",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [],
  "author": "Luiz Otavio Valenzi Sousa",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "copyright": "Copyright © 2026 Luiz Otavio Valenzi Sousa",
    "appId": "com.teravs.desktop",
    "productName": "Teravs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "config/**/*",
      "LICENSE",
      "AUTHORSHIP.md",
      "THIRD_PARTY_NOTICES.md",
      "docs/legal/third-party/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
