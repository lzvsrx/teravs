# Developer/deployment configuration. Never put credentials in VITE_* variables.
OLLAMA_URL=http://127.0.0.1:11434
TERAVS_MODEL=qwen3:4b
TERAVS_GPU_LAYERS=0
HOST=127.0.0.1
PORT=4318
TERAVS_DB=data/teravs.sqlite
# Set DATABASE_URL only on the server to use PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Exact browser origins allowed to call your server (comma-separated).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost,https://localhost,null
# Build-time public backend address for GitHub Pages / Android, never a secret.
# VITE_TERAVS_API_URL=https://your-api.example.com
